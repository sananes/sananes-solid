# Copy to .env and fill in. Only needed if you opt into ~/integrations/sanity.

# VITE_ vars are inlined into the client bundle at build time, so they are
# public. The project id and dataset name are not credentials — this is fine.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# Pinned API version. Defaults to the date in src/integrations/sanity/env.ts; override only
# when you mean to, and re-run `bun run sanity:typegen` after.
# VITE_SANITY_API_VERSION=2026-08-01

# Only for a private dataset. Read behind an `isServer` guard so it is stripped
# from the client bundle and used during prerender only. A token also makes every
# read uncached, so leave it unset for a public dataset.
# SANITY_READ_TOKEN=

# The studio has its own env file: see studio/.env.example
